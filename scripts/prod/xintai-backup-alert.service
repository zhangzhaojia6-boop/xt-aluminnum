[Unit]
Description=Notify ops when the daily backup fails

[Service]
Type=oneshot
User=www-data
# 读取备份服务的日志，作为通知里的失败原因
SupplementaryGroups=systemd-journal
WorkingDirectory=/srv/aluminum-bypass/backend
EnvironmentFile=/srv/aluminum-bypass/backend/.env
# systemd 会先展开 $，所以命令里的 $ 写成 $$
ExecStart=/bin/bash -c 'reason=$$(journalctl -u xintai-daily-backup -n 30 --no-pager -o cat | grep -v -E "^(xintai-daily-backup.service: |Starting |Finished |Failed to start )" | tail -1); exec /srv/aluminum-bypass/backend/.venv/bin/python scripts/notify_backup_failure.py "$$reason"'
