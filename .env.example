# ⚠ NEVER commit .env to version control
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Generate POSTGRES_PASSWORD: python -c "import secrets; print(secrets.token_hex(16))"

APP_ENV=production
APP_VERSION=0.4.0

# PostgreSQL settings
POSTGRES_USER=bypass_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=aluminum_bypass

# Backend runtime settings
SECRET_KEY=CHANGE_ME_SECRET_KEY_FOR_DEPLOYMENT_ONLY_32CHARS_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Quick cloud trial recommended value: https://your-domain.example
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
PRODUCTION_CORS_ORIGINS=https://data.xintai-alu.com,https://m.xintai-alu.com
DEFAULT_TIMEZONE=Asia/Shanghai
UPLOAD_DIR=./backend/uploads
MOBILE_DATA_ENTRY_MODE=manual_only
MOBILE_SCAN_ASSIST_ENABLED=false
MOBILE_MES_DISPLAY_ENABLED=false
MES_ADAPTER=null
MES_API_BASE=
MES_API_KEY=
MES_API_TIMEOUT_SECONDS=8
MES_API_TRACKING_CARD_INFO_PATH=/tracking-cards/{card_no}
MES_API_COIL_SNAPSHOTS_PATH=/coil-snapshots
MES_SQLSERVER_HOST=
MES_SQLSERVER_PORT=1433
MES_SQLSERVER_DATABASE=
MES_SQLSERVER_USERNAME=
MES_SQLSERVER_PASSWORD=
MES_SQLSERVER_TIMEOUT_SECONDS=8
MES_SQLSERVER_ENCRYPT=false
IOT_ENERGY_ADAPTER=null
IOT_ENERGY_SQLSERVER_HOST=
IOT_ENERGY_SQLSERVER_PORT=1433
IOT_ENERGY_SQLSERVER_DATABASE=
IOT_ENERGY_SQLSERVER_USERNAME=
IOT_ENERGY_SQLSERVER_PASSWORD=
IOT_ENERGY_SQLSERVER_QUERY=
IOT_ENERGY_SQLSERVER_TIMEOUT_SECONDS=8
IOT_ENERGY_SQLSERVER_ENCRYPT=false
IOT_ENERGY_METER_MAP={}
IOT_ENERGY_SYNC_POLL_SECONDS=60
IOT_ENERGY_SYNC_RETRY_LIMIT=3
IOT_ENERGY_SYNC_BACKOFF_SECONDS=2
MES_MVC_BASE_URL=
MES_MVC_USERNAME=
MES_MVC_PASSWORD=
MES_MVC_TIMEOUT_SECONDS=8
MES_SYNC_LIMIT=200
MES_SYNC_WINDOW_MINUTES=10
MES_SYNC_POLL_MINUTES=1
MES_SYNC_RETRY_LIMIT=3
MES_SYNC_BACKOFF_SECONDS=2

# Optional external integrations
DINGTALK_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_INBOUND_TOKEN=

# Workflow delivery toggles (keep disabled until adapters are wired for quick cloud trial)
WORKFLOW_ENABLED=false
AUTO_PUBLISH_ENABLED=true
AUTO_PUSH_ENABLED=true
AUTO_PIPELINE_REQUIRE_READY=true
WECOM_BOT_ENABLED=false
WECOM_BOT_DRY_RUN=false
WECOM_BOT_WEBHOOK_URL=
WECOM_BOT_MANAGEMENT_WEBHOOK_URL=
WECOM_BOT_WORKSHOP_WEBHOOK_MAP={}
WECOM_BOT_TEAM_WEBHOOK_MAP={}
WECOM_BOT_TIMEOUT_SECONDS=8
WECOM_APP_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=

# Statistics module usable-after-config
LLM_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT_ID=
LLM_IMAGE_MODEL=
LLM_IMAGE_ENDPOINT_ID=
LLM_TIMEOUT_SECONDS=20
LLM_DAILY_QUERY_LIMIT=50
APP_CONNECTION_ENABLED=false
APP_CONNECTION_API_BASE=
APP_CONNECTION_API_KEY=
APP_CONNECTION_TIMEOUT_SECONDS=8
APP_CONNECTION_PUSH_MODE=disabled
MANAGEMENT_ESTIMATE_REVENUE_PER_TON=
MANAGEMENT_ESTIMATE_ELECTRICITY_COST_PER_UNIT=
MANAGEMENT_ESTIMATE_GAS_COST_PER_UNIT=
MANAGEMENT_ESTIMATE_LABOR_COST_PER_ATTENDANCE=

# Initial admin user
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_FOR_DEPLOYMENT
INIT_ADMIN_NAME=系统管理员

# Frontend runtime settings
VITE_API_BASE_URL=/api/v1

# Quick cloud trial keeps the browser path first and leaves WeCom off.

# 企业微信自建应用（Phase 1B）
# 在企业微信管理后台 → 应用管理 → 自建应用中获取
# WECOM_CORP_ID=你的企业ID
# WECOM_AGENT_ID=你的应用AgentId
# WECOM_APP_SECRET=你的应用Secret
# WECOM_APP_ENABLED=true
# WORKFLOW_ENABLED=true
