{
  "name": "aluminum-bypass-frontend",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=moderate",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/compose-smoke.spec.js",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.12",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "form-data": "^4.0.6"
  }
}
